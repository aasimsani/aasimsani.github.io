// Cloudflare Workers Builds reads this file to give every pull request a preview
// URL. GitHub Pages still serves aasimsani.net from master, so this Worker only
// hosts previews. The site is static, so no Worker code runs and preview
// traffic doesn't count against the Workers request limit.
{
  "name": "aasimsani-net",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist"
  },
  "preview_urls": true
}
