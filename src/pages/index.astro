---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionNav from "../components/SectionNav.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Experience from "../components/Experience.astro";
import Awards from "../components/Awards.astro";
import Education from "../components/Education.astro";
import Speaking from "../components/Speaking.astro";
import Projects from "../components/Projects.astro";
import News from "../components/News.astro";
import Research from "../components/Research.astro";
import Footer from "../components/Footer.astro";
import World from "../components/World.astro";
import AdventureSwitch from "../components/AdventureSwitch.astro";
import Writing from "../components/Writing.astro";
import { homeSchema } from "../data/schema";
import { nav } from "../data/nav";

// Each section's component, by its id in nav.ts. The page renders them in that file's order.
const sections: Record<string, any> = {
  experience: Experience,
  writing: Writing,
  projects: Projects,
  publicspeaking: Speaking,
  news: News,
  awards: Awards,
  education: Education,
  research: Research,
};
const missing = nav.find((s) => !sections[s.id]);
if (missing) throw new Error(`No component for section "${missing.id}" in src/pages/index.astro`);
---

<BaseLayout jsonLd={homeSchema()}>
  <ThemeToggle />
  <Hero />
  <SectionNav />
  {/* The section nav stays outside <main>, so it keeps sticking while the footer scrolls past. */}
  <main id="main" tabindex="-1">
    {nav.map((s) => {
      const Section = sections[s.id];
      return <Section />;
    })}
  </main>
  <Footer />
  <World />
  <AdventureSwitch />
</BaseLayout>
