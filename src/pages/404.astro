---
// GitHub Pages serves this page for any missing path. Serious mode shows the text and a way home. After
// hours adds a scene: the road breaks off, the hero stops at the edge, and a ghost floats over the gap.
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BlogNav from "../components/post/BlogNav.astro";
---

<BaseLayout title="Page not found · Aasim Sani" description="This page doesn't exist.">
  <ThemeToggle />
  <BlogNav />
  <main class="nf">
    <div class="nf-text">
      <p class="nf-kicker"><span class="afterhours-only">404 &middot; Zone not found</span><span class="serious-only">404</span></p>
      <h1><span class="afterhours-only">This page wandered off.</span><span class="serious-only">This page doesn&rsquo;t exist.</span></h1>
      <p class="afterhours-only">The road ends here. Head back and the hero will meet you at the start.</p>
      <p class="serious-only">The link may be old, or the page may have moved.</p>
      <a class="nf-home" href="/"><span class="afterhours-only">Back to the road</span><span class="serious-only">Go to the homepage</span></a>
    </div>
    <canvas class="nf-scene afterhours-only" width="200" height="110" aria-hidden="true"></canvas>
  </main>
</BaseLayout>

<script>
  import { painterFor, hex } from "../scripts/pixelfx/core/index.js";
  import { Layer, createFx } from "../scripts/companion/effects";
  import { LEGS, LOOKS } from "../scripts/companion/sprites";
  import * as ghost from "../scripts/pixelfx/fx/critters/ghost.js";

  const cv = document.querySelector<HTMLCanvasElement>(".nf-scene")!;
  const ctx = cv.getContext("2d")!;
  const layer = new Layer();
  layer.resize(200, 110);
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const g = createFx(ghost, { hover: 14, palette: ["#14162e", "#2b3060", "#5a6aa8", "#9fb0e8", "#d8e0ff", "#f4f6ff", "#ffffff"] });
  const SIGN = ["oooooooooooo", "oWWWWWWWWWWo", "oWkWkWWkWkWo", "oWkWkWkWkWkW", "oWkkkWkWkkkW", "oWWWkWkWWWkW", "oWWWkWWkWWkW", "oooooooooooo", ".....oo.....", ".....oo.....", ".....oo.....", ".....oo....."];
  // Colors come from the theme's world tokens, so dawn gets a dawn sky.
  const token = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

  function scene(t: number) {
    const c = { top: token("--world-sky-top"), bot: token("--world-sky-bottom"), far: token("--world-far"), hi: token("--world-road-hi"), road: token("--world-road"), lo: token("--world-road-lo"), rock: token("--world-rock"), text: token("--color-text") };
    layer.clear();
    const p = painterFor(layer.frame);
    p.place(0, 0);
    // The sky steps from top to bottom color in six bands, and the gap past the road falls into the dark.
    const mixHex = (a: string, b: string, k: number) => {
      const [A, B] = [a, b].map((h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)));
      return "#" + A.map((v, i) => Math.round(v + (B[i] - v) * k).toString(16).padStart(2, "0")).join("");
    };
    for (let i = 0; i < 6; i++) p.rect(0, i * 15, 200, 15, hex(mixHex(c.top, c.bot, i / 5)));
    p.rect(120, 90, 80, 20, hex(c.lo));
    for (let x = 0; x < 120; x += 2) p.rect(x, 90 - (6 + ((x * 7) % 23 > 15 ? 6 : 0)), 2, 6 + ((x * 7) % 23 > 15 ? 6 : 0), hex(c.far));
    // The road runs out at x = 120 and crumbles into the gap.
    p.rect(0, 90, 120, 2, hex(c.hi));
    p.rect(0, 92, 120, 6, hex(c.road));
    p.rect(0, 98, 120, 12, hex(c.rock));
    for (let i = 0; i < 6; i++) p.rect(120 + i * 2, 90 + i * 2, 2, 20, hex(i % 2 ? c.road : c.lo));
    for (let i = 0; i < 4; i++) p.rect(122 + i * 3, 92 + ((t * 20 + i * 9) % 18), 1, 1, hex(c.hi));
    p.sprite(SIGN, { o: c.lo, W: c.hi, k: c.text }, 100, 78);
    const look = LOOKS[1];
    p.sprite(LEGS.idle, look.pal, 64, 85);
    p.sprite(look.body, look.pal, 64, 59);
    layer.draw(g, 150, 70);
    ctx.clearRect(0, 0, 200, 110);
    ctx.drawImage(layer.flush(), 0, 0);
  }

  let last = performance.now(), t = 0;
  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    if (document.documentElement.dataset.siteMode === "afterhours") {
      t += dt;
      g.update(dt);
      scene(t);
    }
    if (!reduce) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
</script>

<style>
  .nf {
    min-height: 80vh;
    max-width: 1000px;
    margin: 0 auto;
    padding: 8rem 1.5rem 4rem;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2rem;
    align-items: center;
  }
  .nf .nf-kicker { font-family: var(--font-ui); color: var(--color-accent); letter-spacing: 0.04em; margin: 0 0 0.5rem; }
  .nf h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; margin: 0 0 1rem; }
  .nf p { color: var(--color-text-soft); }
  .nf-home {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-ui);
    background: var(--color-surface);
    color: var(--color-text);
    padding: 0.7rem 1rem;
    text-decoration: none;
  }
  .nf-home:hover, .nf-home:focus-visible { background: var(--color-accent); color: var(--color-bg); }
  .nf-scene { width: 100%; image-rendering: pixelated; }
  :global([data-site-mode="serious"]) .nf { grid-template-columns: 1fr; }
  @media (max-width: 700px) {
    .nf { grid-template-columns: 1fr; padding-top: 6rem; }
  }
</style>
