---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import Footer from "../../components/Footer.astro";
import BlogAdventureSwitch from "../../components/post/BlogAdventureSwitch.astro";
import BlogNav from "../../components/post/BlogNav.astro";
import PostCard from "../../components/PostCard.astro";
import { newestFirst } from "../../data/posts";
import { site } from "../../data/site";
import { blogSchema } from "../../data/schema";

const sorted = newestFirst();
---

<BaseLayout
  title="Writing · Aasim Sani"
  description={site.feedDescription}
  ogType="website"
  ogTitle="Writing · Aasim Sani"
  canonical={`${site.url}blog/`}
  jsonLd={blogSchema()}
>
  <ThemeToggle />
  <BlogNav current="blog" />
  <main class="blog-index" id="main" tabindex="-1">
    <header>
      <h1>Writing</h1>
      <p class="tagline">{site.feedDescription}</p>
      <p class="feed"><a href="/rss.xml">Follow by RSS</a></p>
    </header>
    <ul class="post-list">
      {sorted.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))}
    </ul>
  </main>
  <Footer />
  <BlogAdventureSwitch />
</BaseLayout>

<style>
  .blog-index {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    min-height: 70vh;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    margin: 0 0 0.4rem;
  }
  .tagline {
    color: var(--color-text-soft);
    margin-bottom: 0.6rem;
  }
  .feed {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    margin-bottom: 3rem;
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
</style>
