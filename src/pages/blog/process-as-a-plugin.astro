---
// Every number and example on this page comes from the four repos' READMEs or
// from a saved eval run. The explorers read src/data/toolkits.ts, which
// scripts/extract-toolkits.mjs writes from the two toolkit repos.
import PostLayout from "../../layouts/PostLayout.astro";
import PostSection from "../../components/post/PostSection.astro";
import Reveal from "../../components/post/Reveal.astro";
import CaseFile from "../../components/post/CaseFile.astro";
import Checklist from "../../components/post/Checklist.astro";
import Sources from "../../components/post/Sources.astro";
import StageRail from "../../components/post/StageRail.astro";
import Explorer from "../../components/post/Explorer.astro";
import Stepper from "../../components/post/Stepper.astro";
import { testingGroups, testingCards, fvGroups, fvCards, claimShapes } from "../../data/toolkits";

type Badge = "toolkits" | "alone" | "none";

const stages: { no: string; name: string; line: string; habit: string; plugin: string; example: string; badge: Badge; skippable?: boolean }[] = [
  {
    no: "01",
    name: "Intent",
    line: "One page on why the work is worth doing.",
    habit: "None of mine. The stage follows Anthropic’s playbook, which puts an intent where a backlog entry used to be.",
    plugin: "Runs EGM’s brainstorm with the person who has the idea, then distills it into intent.md: the problem, the outcome, success criteria and what’s out of scope.",
    example: "The brainstorm has never run in an eval, because no eval has loaded EGM. One eval covers the gate instead: a request for a spec is refused while the intent is still a draft.",
    badge: "none",
  },
  {
    no: "02",
    name: "Spec",
    line: "What gets built, as requirements someone can test.",
    habit: "Also from the playbook. I had no written habit of my own here.",
    plugin: "Turns the approved intent into spec.md: requirements, acceptance criteria and risks. It says what, and leaves how to the RFC.",
    example: "From a one-page intent for a CSV export, the spec lists nine requirements and ten acceptance criteria. The tenth: an export of 2,000 rows runs in under 5 seconds, timed in a test.",
    badge: "alone",
  },
  {
    no: "03",
    name: "RFC",
    line: "How it gets built, and the options that lost.",
    habit: "I write RFCs as a reviewable page with a fixed spine: problem and goal, constraints, options, chosen solution, build plan, phases, tickets, blast radius. Diagrams come first.",
    plugin: "Calls my rfc skill for the document. When the design makes a never or always claim, the fv-toolkit checks that claim in a model before any code exists.",
    example: "A draft design claimed that a voucher is never captured above its face value. The model checker found seven steps that capture 6 on a voucher worth 5. Section 04 steps through them.",
    badge: "toolkits",
    skippable: true,
  },
  {
    no: "04",
    name: "Plan",
    line: "Phases, files and every test, decided before code.",
    habit: "Every plan I write has phases as a dependency graph, and a todo list for one phase at a time. I build test first, so the tests are chosen here.",
    plugin: "Turns the RFC’s phases into plan.md. The testing toolkit picks a kind of test for each acceptance criterion, and says which stage writes it.",
    example: "A test table with five rows. Build writes four of them. The fifth, a timing test on 2,000 invoices, is a load test, so the plan gives it to the Test stage.",
    badge: "toolkits",
  },
  {
    no: "05",
    name: "Build",
    line: "One phase at a time: failing test, code, refactor.",
    habit: "Red, green, refactor, one cycle at a time. Never commit on the default branch. Commit messages record the decision and what was rejected. I run ponytail on my own work.",
    plugin: "Writes each Build test before its code through the testing toolkit, codes in ponytail mode, then runs pr-review on the local branch after each phase.",
    example: "The first test failed because --csv was an unknown option. It passed after the change. Then it failed again on a planted bug that dropped two fields from each row.",
    badge: "toolkits",
  },
  {
    no: "06",
    name: "Test",
    line: "Final tests, an audit, and checks by sessions that didn’t write the code.",
    habit: "Run the tests before committing, and get a review before a push. The fresh sessions are the playbook’s idea.",
    plugin: "Writes the final tests, audits the whole suite, and sends a verifier subagent to run the app. When the design was modelled, a second subagent models the code.",
    example: "The audit removed two tests: one that ended in “; true” and could never fail, and one duplicate. For each, it named the stronger test that covers the same bug.",
    badge: "toolkits",
  },
  {
    no: "07",
    name: "Ship",
    line: "A pull request that a person approves and merges.",
    habit: "My PR descriptions are a table of each change and what it does, with a decisions section. A person merges.",
    plugin: "Runs pr-review on the PR, writes review.md, opens the PR with links to every artifact, and stops. It never approves or merges.",
    example: "The reply after the PR opened: “The PR is open, but ship isn’t finished: Lee still has to approve and merge it.” Lee is the fixture’s tech lead.",
    badge: "alone",
  },
  {
    no: "08",
    name: "ADR",
    line: "The RFC, rewritten to what actually shipped.",
    habit: "New. I asked for it while I built the plugin: after Ship, copy the RFC and update the copy to what was built.",
    plugin: "Copies the RFC, compares it with the merged code, and records each place where the two differ, with the reason when one is on record.",
    example: "The ADR lists five departures from the RFC. The first: the RFC chose a separate lib/csv.awk, and the shipped code quotes fields inline, because the function has one caller.",
    badge: "alone",
    skippable: true,
  },
  {
    no: "09",
    name: "Maintain",
    line: "Measure the result, and turn the shortfall into the next intent.",
    habit: "From the playbook. I had no written habit here either.",
    plugin: "Compares live measurements with the intent’s success criteria, writes lessons.md, and opens a follow-up intent for anything that fell short.",
    example: "Nine of eleven finance accounts stopped copying invoices by hand. The two largest didn’t, because an export over 5,000 invoices took more than 30 seconds. That became a new intent.",
    badge: "alone",
  },
];

const helpers = [
  { name: "EGM", from: "Google", does: "Reviews a document with reviewers that never saw the conversation that produced it.", calls: [1, 2, 3, 4, 8, 9] },
  { name: "rfc skill", from: "My skill", does: "Writes the RFC as a page with a fixed spine, diagrams first.", calls: [3] },
  { name: "Testing toolkit", from: "My repo", does: "Decides the tests in Plan, writes the Build tests before the code, then writes the final tests, checks them all and audits the suite.", calls: [4, 5, 6] },
  { name: "ponytail", from: "Dietrich Gebert", does: "Keeps the plan and the code to the smallest change that works.", calls: [4, 5, 6, 9] },
  { name: "pr-review", from: "My repo", does: "Reviews code in a new session that has only the diff and the repo’s rules.", calls: [5, 6, 7] },
  { name: "fv-toolkit", from: "My repo", does: "Checks a never or always claim in a model, once on the design and once on the code.", calls: [3, 4, 6, 9] },
];

const testingTiles = [
  { title: "It picks the kind of test before it writes one", body: "For each component it asks where the bug would be, and names the kind of test from the answer. Then it lists the kinds it left out, with a reason each. In the plan from section 01: no property tests, because the quoting rule has two special characters and the spec’s two examples cover it." },
  { title: "A test is kept only after it has been seen to fail", body: "A new test has to pass, give the same result five times, and then fail on a planted bug. A step that couldn’t run is named in the report. It never counts as a pass." },
  { title: "Expected values come from the spec, so it finds product bugs", body: "The skill writes down the expected behaviour before it reads the code. When a test written that way fails, it keeps the assertion and reports the disagreement. In one eval, three tests failed after a change and the request called all three out of date. The toolkit updated two, kept the third, and named the regression the third had caught." },
  { title: "Nothing is deleted without proof", body: "The audit removes a test only when it can name a stronger test for the same contract. Its ledger has one row per removal: what the test detects, what covers it, and the check that was run." },
  { title: "18 skills that close a loop", body: "Six write tests. Four run campaigns such as fuzzing and load. Four analyse a suite. Three cover running systems. One router sends the work to the right one. An analysis finds a gap, and an authoring skill closes it with one new test." },
];

const fvTiles = [
  { title: "It picks the check by the shape of the claim", body: "Seven shapes, and the cheapest check that can fail for each. Only two of the seven get a model. The other five get tests on the real code, or checks on the real data." },
  { title: "It says no", body: "A factory and an adapter have no invariant of their own. One eval case passes only when no tool skill loads for them and the reply names an ordinary test." },
  { title: "One router over 16 tool skills", body: "Three are core: TLA+ with TLC, Alloy and Hypothesis. The other thirteen install the first time the router names them, so nobody installs a Rust model checker to verify a Python service." },
  { title: "A catalog from architecture pattern to check", body: "166 patterns in seven catalogs. Each row says what breaks, which tool fits, what to model, which properties to state and how to tie the model to the code. Before I built it I found at least 24 comparable skill repos and read 17 in depth. None of the 17 maps architecture patterns to tools." },
  { title: "A pass counts only after the check has failed", body: "Every model ships with a config that must fail, witnesses that show the interesting states can be reached, and planted bugs it has to detect. A pass with none of those could come from a model in which nothing can go wrong." },
  { title: "The answer is readable without the tool", body: "A counterexample comes back as numbered steps in the system’s own words: tills, holds, the sweeper. The stepper below is one, copied from the file the run wrote." },
  { title: "Models stay true to the code", body: "fv-pin records a hash of each property a person confirmed, so a check can’t be made to pass by weakening the property. fv-drift reports when the code a model covers has changed since the model was written." },
];

const reviewTiles = [
  { title: "The reviewer never saw the build session", body: "The script starts a new headless session with claude -p. That session has the diff and the repo’s rules, and none of the author’s reasoning." },
  { title: "Who reviews is a markdown file", body: "The built-in panel is three senior engineers, then a tech lead who checks their findings against the wider codebase. A panel file replaces all four. A lens adds a reviewer or a rule on top." },
  { title: "Reviews are comparable from run to run", body: "The severity scale, the references, the fingerprints and the output format never change, whichever panel ran. So two reviews of one branch can be compared line by line." },
  { title: "A PR can’t rewrite its own rules", body: "The review rules are read from the base branch, never from the PR’s head. A PR that edits REVIEW.md is still reviewed under the old rules." },
  { title: "Nothing is posted, and the review can be resumed", body: "Each review is saved as a markdown file with a Claude session I can resume to ask the reviewer a follow-up question. Nothing goes to GitHub." },
];

const gauntlet = [
  { title: "Written from the spec.", body: "The acceptance criterion says the export prints a header and four rows. The expected text comes from that sentence, before any code exists.", values: { Result: "not run yet" } },
  { title: "Fails first.", body: "The test runs against the unchanged script and fails, because --csv is an unknown option (exit 2).", values: { Result: "fails, exit 2" } },
  { title: "Passes.", body: "The phase’s code is written, and the test passes.", values: { Result: "passes" } },
  { title: "Fails on a planted bug.", body: "In a copy of the code, the amount and status fields are dropped from each row. The test fails, so it can catch that bug.", values: { Result: "fails on the plant" }, alert: "Result" },
  { title: "Kept.", body: "The test goes in the report with its evidence: failed first, passed after the change, failed on the plant.", values: { Result: "kept, with evidence" } },
];

const trace = [
  { title: "Start.", body: "The voucher is worth 5. Tills A and B are idle.", values: { Available: "5", "On hold": "0", Captured: "0" } },
  { title: "Till A holds 3.", body: "Its sale begins.", values: { Available: "2", "On hold": "3", Captured: "0" } },
  { title: "A’s hold expires.", body: "Ten minutes pass while the customer is still paying the rest by card." },
  { title: "The sweeper releases the hold.", body: "The 3 goes back to the voucher.", values: { Available: "5", "On hold": "0", Captured: "0" } },
  { title: "A’s sale completes.", body: "It captures its hold by id. Nothing checks that the hold is still live.", values: { Available: "5", "On hold": "0", Captured: "3" } },
  { title: "Till B holds 3.", body: "The voucher still shows 5 available.", values: { Available: "2", "On hold": "3", Captured: "3" } },
  { title: "B captures.", body: "Captured is now 6 on a voucher worth 5.", values: { Available: "2", "On hold": "0", Captured: "6" }, alert: "Captured" },
];

// The seven shapes, checks and reasons come from the toolkit. The example sentences are written for this post.
const claimExamples = [
  "A voucher is never captured above its face value, even when two tills use it at once.",
  "Every project has exactly one owner, and a viewer can never delete it.",
  "Each of the twelve plan and region pairs gets exactly one tax treatment.",
  "No billing period overlaps the next one, whatever the start date.",
  "The nightly batch and the live stream always report the same totals.",
  "Splitting an invoice across its lines never loses a cent.",
  "No two rate rows cover the same date for the same region.",
];

const tools = fvCards.filter((c) => c.group === "tools").map((c) => ({ name: c.title, core: c.fields[1].value.startsWith("Core") }));

const installs = [
  { key: "loop", tag: "sdlc-toolkit", title: "Install the loop.", body: "claude plugin marketplace add aasimsani/sdlc-toolkit, then claude plugin install sdlc@sdlc-toolkit" },
  { key: "setup", tag: "sdlc-toolkit", title: "Set up one repo.", body: "Run /sdlc:setup in it. It installs the five plugins the stages call, and makes sure CLAUDE.md names one verify command." },
  { key: "feature", tag: "sdlc-toolkit", title: "Take one small feature through it.", body: "Run /sdlc:sdlc with your idea. Approve each artifact yourself." },
  { key: "testing", tag: "testing-toolkit", title: "Or take the testing toolkit alone.", body: "claude plugin marketplace add aasimsani/testing-toolkit, then claude plugin install testing-toolkit@testing-toolkit" },
  { key: "fv", tag: "formal-verification-toolkit", title: "Or the fv-toolkit alone.", body: "claude plugin marketplace add aasimsani/formal-verification-toolkit, then claude plugin install fv-toolkit@formal-verification-toolkit" },
  { key: "review", tag: "pr-review", title: "Or pr-review alone.", body: "claude plugin marketplace add aasimsani/pr-review, then claude plugin install pr-review@aasimsani-pr-review" },
];

const stopX = (i: number) => 44 + i * 74;
---

<PostLayout
  slug="process-as-a-plugin"
  kicker="Process · as a plugin"
  headline="I turned my engineering process into a plugin"
  dek="I wrote down how I build software and gave it to a coding agent as nine stages. Here is each stage, the specialist it calls, and what has and hasn’t been tested."
  shareText="I turned my engineering process into a plugin: nine stages, six helpers, and a list of what isn't tested yet."
>

    <PostSection id="open">
      <p class="lede">
        Until this month, my engineering process lived in two places: a long
        <code>CLAUDE.md</code> file and my own habits.
      </p>
      <p>
        I&rsquo;ve now written it down as a plugin for a coding agent. It&rsquo;s
        called <code>sdlc</code>.<sup><a href="#src-9">9</a></sup> It takes one
        feature through nine stages, and each stage ends when a person approves
        one written artifact. The order of the stages comes from
        Anthropic&rsquo;s playbook for AI-native teams.<sup><a href="#src-1">1</a></sup>
        Most of what happens inside a stage is how I already worked.
      </p>

      <aside class="status post-panel" aria-label="Status: built on 11 and 12 November 2026. Each stage is tested on small fixtures. No real feature has gone through the whole loop yet.">
        <p class="status-label">Status &middot; 13 November 2026</p>
        <ul>
          <li><b>Built</b> on 11 and 12 November 2026.</li>
          <li><b>Tested</b> one stage at a time, on small made-up repos.</li>
          <li><b>Not yet used</b> on a real feature from start to finish.</li>
        </ul>
        <p>I&rsquo;ll update this post when a real feature has gone through it.</p>
      </aside>

      <figure class="fig post-panel" role="img" aria-label="The loop: intent, spec, RFC, plan, build, test, ship, ADR, maintain. Follow-ups and incidents return to intent. The approver may skip the RFC and the ADR.">
        <figcaption class="chart-title">The whole loop</figcaption>
        <svg viewBox="0 0 680 172" xmlns="http://www.w3.org/2000/svg" font-family="var(--font-ui)">
          <defs>
            <marker id="rail-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--color-muted)" stroke-width="1.6"/>
            </marker>
          </defs>
          <line x1={stopX(0)} y1="46" x2={stopX(8)} y2="46" stroke="var(--color-line)" stroke-width="2"/>
          {stages.map((s, i) => (
            <g>
              <circle cx={stopX(i)} cy="46" r="12" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="1.6" stroke-dasharray={s.skippable ? "3 3" : undefined}/>
              <text x={stopX(i)} y="50" text-anchor="middle" fill="var(--color-accent)" font-size="10">{i + 1}</text>
              <text x={stopX(i)} y="80" text-anchor="middle" fill="var(--color-text)" font-size="12">{s.name}</text>
            </g>
          ))}
          <path d={`M ${stopX(8)} 92 C ${stopX(8)} 150, ${stopX(0)} 150, ${stopX(0)} 92`} fill="none" stroke="var(--color-muted)" stroke-width="1.5" stroke-dasharray="5 5" marker-end="url(#rail-arr)"/>
          <text x="340" y="126" text-anchor="middle" fill="var(--color-muted)" font-size="11">follow-ups and incidents become new intents</text>
          <text x="340" y="166" text-anchor="middle" fill="var(--color-muted)" font-size="10.5">dashed stop: the approver may skip it for a small change</text>
        </svg>
      </figure>

      <p>
        Read as far as you like. That picture is the whole loop. Section 01
        opens each stop. Sections 03 to 05 go inside the three specialists I
        built, down to every scenario they encode.
      </p>
    </PostSection>

    <PostSection id="loop" no="01" label="The loop" title="One stop at a time">
      <p class="lede">
        Each stop opens to three things: the habit it came from, what the
        plugin does there, and one example of the step being done.
      </p>
      <p>
        Every example comes from an eval, which is a scripted run on a small
        made-up repo with graders that check the result.<sup><a href="#src-6">6</a></sup>
        The badge says how much was loaded in that run.
      </p>
      <ul class="badge-key">
        <li><span class="rail-badge rail-badge-toolkits">Run with the toolkits</span> The loop, the testing toolkit and the fv-toolkit were all loaded.</li>
        <li><span class="rail-badge rail-badge-alone">Run alone</span> Only the loop was loaded, and the prompt named the other tools as missing.</li>
        <li><span class="rail-badge">Not run yet</span> The step calls a tool that no eval has loaded.</li>
      </ul>

      <StageRail id="stages" label="The nine stages. Each one opens to its habit, what the plugin does and one example." stages={stages} />

      <p>
        Three stops have no habit of mine behind them. Intent, Spec and
        Maintain follow the playbook, which has six phases where my loop has
        nine stages.<sup><a href="#src-1">1</a></sup>
      </p>

      <h3>A stage has three states</h3>
      <figure class="fig post-panel" role="img" aria-label="A stage is a draft until a person approves it or skips it. Claude can write draft, and only a person's decision produces approved or skipped. A later stage that finds an approved artifact wrong sends it back to draft.">
        <svg viewBox="0 -18 680 254" xmlns="http://www.w3.org/2000/svg" font-family="var(--font-ui)">
          <defs>
            <marker id="st-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--color-accent)" stroke-width="1.6"/>
            </marker>
            <marker id="st-arr-soft" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 1 L 9 5 L 0 9" fill="none" stroke="var(--color-muted)" stroke-width="1.6"/>
            </marker>
          </defs>
          <rect x="30" y="98" width="180" height="62" rx="10" fill="var(--color-surface)" stroke="var(--color-line)" stroke-width="1.5"/>
          <text x="120" y="124" text-anchor="middle" fill="var(--color-text)" font-size="14">draft</text>
          <text x="120" y="144" text-anchor="middle" fill="var(--color-muted)" font-size="11">Claude can write this</text>

          <rect x="430" y="50" width="230" height="62" rx="10" fill="var(--color-surface)" stroke="var(--color-teal)" stroke-width="1.5"/>
          <text x="545" y="76" text-anchor="middle" fill="var(--color-teal)" font-size="14">approved</text>
          <text x="545" y="96" text-anchor="middle" fill="var(--color-muted)" font-size="11">only a person</text>

          <rect x="430" y="150" width="230" height="62" rx="10" fill="var(--color-surface)" stroke="var(--color-teal)" stroke-width="1.5"/>
          <text x="545" y="176" text-anchor="middle" fill="var(--color-teal)" font-size="14">skipped</text>
          <text x="545" y="196" text-anchor="middle" fill="var(--color-muted)" font-size="11">only a person, with a reason</text>

          <line x1="210" y1="120" x2="424" y2="90" stroke="var(--color-accent)" stroke-width="2.6" marker-end="url(#st-arr)"/>
          <text x="316" y="90" text-anchor="middle" fill="var(--color-accent)" font-size="11">a person approves</text>
          <line x1="210" y1="140" x2="424" y2="172" stroke="var(--color-accent)" stroke-width="2.6" marker-end="url(#st-arr)"/>
          <text x="316" y="180" text-anchor="middle" fill="var(--color-accent)" font-size="11">a person skips it</text>

          <path d="M 500 46 C 430 4, 200 4, 130 92" fill="none" stroke="var(--color-muted)" stroke-width="1.5" stroke-dasharray="5 5" marker-end="url(#st-arr-soft)"/>
          <text x="316" y="-2" text-anchor="middle" fill="var(--color-muted)" font-size="11">a later stage finds it wrong</text>
        </svg>
      </figure>
      <p>
        The playbook&rsquo;s rule is that the agent that wrote the code has no
        way to approve it.<sup><a href="#src-1">1</a></sup> I applied it to every
        artifact. The approver may skip the RFC for a small change, and the ADR
        is skipped with it. Build, Test and Ship are never skipped.
      </p>
    </PostSection>

    <PostSection id="helpers" no="02" label="The helpers" title="Each stage calls a specialist">
      <p class="lede">
        The loop itself is small. It knows the order of the stages, where each
        artifact goes and who approves it. The expertise sits in six helpers.
      </p>

      <div class="helpers" role="group" aria-label="The six helpers, what each one is expert at, and the stages that call it.">
        {helpers.map((h) => (
          <div class="helper post-panel">
            <p class="helper-from">{h.from}</p>
            <h4>{h.name}</h4>
            <p>{h.does}</p>
            <p class="dots" aria-hidden="true">
              {stages.map((_, i) => <span class={h.calls.includes(i + 1) ? "on" : ""}></span>)}
            </p>
            <p class="helper-calls">{h.calls.map((n) => stages[n - 1].name).join(" · ")}</p>
          </div>
        ))}
      </div>

      <p>
        Two are other people&rsquo;s work, used as they ship. EGM is
        Google&rsquo;s. Its tagline is &ldquo;Design with an elephant. Review
        with a goldfish.&rdquo;<sup><a href="#src-2">2</a></sup> The elephant
        holds the project&rsquo;s context and drafts. Goldfish reviewers read
        the draft without the earlier conversation. Ponytail is Dietrich
        Gebert&rsquo;s, and it pushes for the smallest change that
        works.<sup><a href="#src-4">4</a></sup>
      </p>
      <p>
        The other four are mine. The next three sections cover the three
        I&rsquo;d most want to show another engineer.
      </p>
      <p class="aside">
        <b>The text loads in layers.</b> A session reads the router first, then
        one stage&rsquo;s skill, then only the reference files that stage
        names. The idea is from Anthropic&rsquo;s post on context
        engineering.<sup><a href="#src-5">5</a></sup> My own note from the build
        session: &ldquo;dont really cut I think we follow a way of organizing
        info as progressive disclosure.&rdquo;
      </p>
    </PostSection>

    <PostSection id="testing" no="03" label="Testing toolkit" title="Tests are decided before code">
      <p class="lede">
        I build test first, so the tests have to be chosen before any code
        exists. The testing toolkit<sup><a href="#src-10">10</a></sup> makes
        that choice in Plan, and then does a different job in each of the next
        two stages.
      </p>

      <h3>In one picture</h3>
      <figure class="post-panel" aria-label="One plan's five tests across three stages. Plan decides all five and names a kind for each. Build writes four of them before the code. Test writes the fifth, a load test, then checks all five and audits the suite.">
        <figcaption class="chart-title">One plan&rsquo;s tests, across three stages</figcaption>
        <div class="table-scroll">
          <table class="tbl">
            <thead>
              <tr><th>Test</th><th>Kind</th><th>Plan</th><th>Build</th><th>Test</th></tr>
            </thead>
            <tbody>
              <tr><td>Header and one row per invoice</td><td>Acceptance</td><td class="on">decided</td><td class="on">written first, phase 1</td><td class="on">checked</td></tr>
              <tr><td>Status filter still applies</td><td>Acceptance</td><td class="on">decided</td><td class="on">written first, phase 1</td><td class="on">checked</td></tr>
              <tr><td>Commas and quotes are quoted</td><td>Acceptance</td><td class="on">decided</td><td class="on">written first, phase 2</td><td class="on">checked</td></tr>
              <tr><td>The old table prints the same bytes</td><td>Characterization</td><td class="on">decided</td><td class="on">written first, phase 1</td><td class="on">checked</td></tr>
              <tr><td>2,000 invoices in under 5 seconds</td><td>Load</td><td class="on">decided</td><td class="off">not here</td><td class="hot">written, then checked</td></tr>
            </tbody>
          </table>
        </div>
        <p class="fig-note">
          From the plan one eval run wrote. A Build test drives one
          phase&rsquo;s code. A final test needs the whole feature, so it waits.
        </p>
      </figure>
      <p class="aside">
        &ldquo;I do think tests should be decided in the plan stage since I
        strictly build TDD.&rdquo; I typed that on the day of the build, after
        my first version had the toolkit choose the tests during Build.
      </p>

      <h3>What sets it apart</h3>
      <div class="tiles">
        {testingTiles.map((t) => (
          <details class="explorer-card" name="testing-tiles">
