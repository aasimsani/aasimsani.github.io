---
// Fixed top-right theme toggle. Lives outside the section nav so it stays
// reachable regardless of viewport or scroll position.
---

<button
  type="button"
  class="theme-toggle px-frame"
  aria-label="Toggle light/dark theme"
  title="Toggle theme"
>
  <svg class="t-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
  <svg class="t-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
</button>

<script>
  import { pixelWipe } from "../scripts/wipe";

  function applyToggleState() {
    // Night is the default world, so only an explicit "light" choice means dawn.
    const isDark = document.documentElement.getAttribute("data-theme") !== "light";
    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((btn) => {
      btn.dataset.themeIs = isDark ? "dark" : "light";
    });
  }

  function setTheme(next: string) {
    document.documentElement.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch (e) { /* localStorage blocked */ }
    applyToggleState();
  }

  // Dawn and night swap behind a wall of pixel blocks that spreads from the toggle's corner.
  function toggleTheme() {
    const next = document.documentElement.getAttribute("data-theme") !== "light" ? "light" : "dark";
    // The pixel wipe belongs to After hours. Serious mode just crossfades.
    if (document.documentElement.dataset.siteMode === "serious") setTheme(next);
    else pixelWipe(() => setTheme(next), "top-right");
  }

  document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((btn) => {
    btn.addEventListener("click", toggleTheme);
  });

  applyToggleState();
</script>

<style>
  .theme-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 60;
    display: inline-flex;
    background: var(--color-surface);
    color: var(--color-text-soft);
    border: 0;
    padding: 0.55rem;
    width: 44px;
    height: 44px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition: color 0.12s steps(2), background-color 0.12s steps(2);
  }
  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--color-bg);
    background: var(--color-accent);
  }
  .theme-toggle :global(svg) {
    width: 18px;
    height: 18px;
  }
  .theme-toggle .t-sun { display: none; }
  .theme-toggle .t-moon { display: inline-flex; }
  .theme-toggle[data-theme-is="dark"] .t-sun { display: inline-flex; }
  .theme-toggle[data-theme-is="dark"] .t-moon { display: none; }
</style>
