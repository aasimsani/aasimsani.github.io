---
// Interactive "woven light" particle field for the hero. A 2D-canvas point-cloud
// torus-knot, recolored to the site palette (terracotta / sage / stone on cream)
// and theme-aware. Mounts behind the hero overlay
// and fills .home.
---

<div class="woven-bg serious-only" aria-hidden="true"></div>

<style>
  .woven-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none; /* hero content stays interactive; we read mouse globally */
    /* woven.ts reads these two: the knot's centre as a share of the width, and the face's height as a share of the field. */
    --field-x: 0.5;
    --face-h: 0.7;
  }
  /* Wide screens split the hero, so the field and the face take the right side. */
  @media (min-width: 1100px) {
    .woven-bg {
      --field-x: 0.72;
      --face-h: 0.62;
    }
  }
  /* Narrower screens have no room beside the text, so the field becomes a block above the name. */
  @media (max-width: 1099px) {
    .woven-bg {
      position: relative;
      inset: auto;
      flex: none;
      width: 100%;
      height: min(48vh, 440px);
      --face-h: 0.92;
    }
  }
  .woven-bg :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  // Load the field only when Serious mode is on, and pause the field whenever After hours takes over.
  const mount = document.querySelector<HTMLElement>(".woven-bg");
  let field: { play: () => void; pause: () => void } | null = null;
  const sync = async () => {
    if (!mount) return;
    if (document.documentElement.dataset.siteMode !== "serious") return field?.pause();
    if (!field) field = (await import("../scripts/woven")).mountWoven(mount);
    field.play();
  };
  sync();
  addEventListener("site:mode", sync);
</script>
