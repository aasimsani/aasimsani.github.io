---
// The Serious / After hours switch with wording for the blog. Blog pages have
// no game, so the nudge promises lanterns and a night sky instead of a boss.
import AdventureSwitch from "../AdventureSwitch.astro";
---

<AdventureSwitch
  prompt="Same words, two moods"
  seriousNudge="It's {when} where you are, so you're reading the Serious version. After hours is the same writing by lantern light, with pixel type and a night sky."
  afterhoursNudge="It's {when} where you are, so you're reading After hours. The words are the same, just lit by lanterns. Prefer it plain? There's a Serious version."
  playLabel="Light the lanterns"
/>
