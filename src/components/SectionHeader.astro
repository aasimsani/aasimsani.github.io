---
// Each section is a zone on the wanderer's road, so the heading carries the
// same lantern the background world hangs at that section's crossing.
import { nav } from "../data/nav";
import { lantern } from "../data/lantern";

interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
const zone = nav.findIndex((n) => n.label.toLowerCase() === title.toLowerCase()) + 1;
---

<div class="heading" id={id} data-heading data-title={title}>
  <svg class="lantern afterhours-only" viewBox="0 0 7 11" shape-rendering="crispEdges" aria-hidden="true">
    {lantern.map(([x, y, w, h, part]) => <rect x={x} y={y} width={w} height={h} class={part} />)}
  </svg>
  <div class="titles">
    {zone > 0 && <p class="zone afterhours-only">Zone {zone}</p>}
    <h2 class="heading-text">{title}</h2>
  </div>
</div>

<style>
  .heading {
    display: flex;
    align-items: flex-end;
    gap: 1.1rem;
    margin-bottom: 3rem;
  }
  .lantern {
    width: 28px;
    height: 44px;
    flex: none;
  }
  .lantern .frame {
    fill: var(--color-muted);
  }
  .lantern .flame {
    fill: var(--color-accent);
  }
  .lantern .core {
    fill: var(--color-accent-strong);
  }
  /* After hours keeps each lantern dark until the hero clears that zone. Under siege, the frame flashes. */
  :global([data-site-mode="afterhours"]) .heading:not([data-cleared]) .lantern .flame,
  :global([data-site-mode="afterhours"]) .heading:not([data-cleared]) .lantern .core {
    fill: var(--color-line);
  }
  .heading[data-siege] .lantern .frame {
    fill: var(--color-accent);
    animation: siege 0.5s steps(2) infinite;
  }
  @keyframes siege {
    50% {
      opacity: 0.35;
    }
  }
  .heading[data-cleared] .zone {
    color: var(--color-accent);
  }
  .titles {
    display: grid;
    gap: 0.35rem;
  }
  .zone {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    line-height: 1;
    margin: 0;
    color: var(--color-teal);
  }
  .heading-text {
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 1;
    margin: 0;
  }
</style>
