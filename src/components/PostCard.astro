---
// One post on a listing. The /blog/ index and the homepage's Writing section
// both use it, so a post looks the same wherever it is offered.
import type { Post } from "../data/posts";

interface Props {
  post: Post;
  /** The heading level that fits the page: h2 on the blog index, h3 under the homepage's section heading. */
  level?: "h2" | "h3";
}

const { post, level: Title = "h2" } = Astro.props;
---

<a class="post-card" href={`/blog/${post.slug}/`}>
  <div class="post-meta">
    <span>{post.displayDate}</span>
    <span aria-hidden="true">&middot;</span>
    <span>{post.readingTime}</span>
    {post.audio && (
      <>
        <span aria-hidden="true">&middot;</span>
        <span>Audio version</span>
      </>
    )}
  </div>
  <Title class="post-title">{post.title}</Title>
  <p class="post-desc">{post.description}</p>
  <span class="read-more">Read the essay &rarr;</span>
</a>

<style>
  .post-card {
    display: block;
    padding: 1.8rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .post-card:hover {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-line));
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -18px rgba(0, 0, 0, 0.45);
  }
  /* After hours gives the card the same stepped corners as the essay's panels. The frame clips anything outside
     the box, so the focus ring is drawn just inside it. */
  :global([data-site-mode="afterhours"]) .post-card {
    border: 0;
    border-radius: 0;
    clip-path: polygon(
      0 6px, 6px 6px, 6px 0, calc(100% - 6px) 0, calc(100% - 6px) 6px, 100% 6px,
      100% calc(100% - 6px), calc(100% - 6px) calc(100% - 6px), calc(100% - 6px) 100%,
      6px 100%, 6px calc(100% - 6px), 0 calc(100% - 6px)
    );
  }
  :global([data-site-mode="afterhours"]) .post-card:focus-visible {
    outline-offset: -5px;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-bottom: 0.6rem;
  }
  .post-title {
    font-size: 1.6rem;
    line-height: 1.25;
    margin: 0 0 0.6rem;
  }
  .post-desc {
    color: var(--color-text-soft);
    font-size: 0.95rem;
    margin-bottom: 0.9rem;
  }
  .read-more {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    color: var(--color-accent);
  }
</style>
