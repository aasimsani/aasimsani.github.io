---
import { articles, podcasts } from "../data/news";
import SectionHeader from "./SectionHeader.astro";

const lists = [
  { title: "Articles", items: articles },
  { title: "Podcasts", items: podcasts },
];
---

<section class="news section-anchor" id="news">
  <div class="container">
    <SectionHeader title="News and media" />
    <div class="lists">
      {lists.map((l) => (
        <div class="list">
          <h3>{l.title}</h3>
          <ul>
            {l.items.map((i) => (
              <li>
                <span class="outlet">{i.outlet}</span>
                <a href={i.link} target="_blank" rel="noopener">{i.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .news {
    padding: 5rem 1.5rem;
    background: transparent;
  }
  .container {
    max-width: 1000px;
    margin: 0 auto;
  }
  .lists {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
  }
  @media (max-width: 800px) {
    .lists {
      grid-template-columns: 1fr;
    }
  }
  h3 {
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--color-line);
    align-items: baseline;
  }
  @media (max-width: 480px) {
    li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
  .outlet {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  li a {
    color: var(--color-text);
    text-decoration-color: var(--color-line);
  }
  li a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }
</style>
