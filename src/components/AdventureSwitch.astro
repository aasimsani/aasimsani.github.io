---
// The "choose your own adventure" control. It stays pinned to the bottom of
// the screen, so switching between Serious and After hours is always one tap
// away. First-time visitors get a speech bubble that explains which version
// their clock picked and offers the other one. Pages other than the
// homepage can swap the wording, and {when} in a nudge becomes the visitor's
// local day and time.
interface Props {
  prompt?: string;
  seriousNudge?: string;
  afterhoursNudge?: string;
  playLabel?: string;
}

const {
  prompt = "Choose your adventure",
  seriousNudge = "It's {when} where you are, so you got Serious mode. After hours has sword fights, a keyboard-wielding thought leader and a final boss.",
  afterhoursNudge = "It's {when} where you are, so you got After hours mode. Here on business? There's a Serious version too.",
  playLabel = "Play After hours",
} = Astro.props;
---

<div class="adventure px-frame" role="group" aria-label={prompt}>
  <span class="cyoa">{prompt}</span>
  <div class="options">
    <span class="pill" aria-hidden="true"></span>
    <button type="button" data-site="serious" aria-pressed="false">Serious</button>
    <button type="button" data-site="afterhours" aria-pressed="false">After hours</button>
  </div>
</div>

<div
  class="nudge px-frame"
  role="status"
  hidden
  data-serious={seriousNudge}
  data-afterhours={afterhoursNudge}
  data-play={playLabel}
>
  <p class="nudge-text"></p>
  <div class="nudge-actions">
    <button type="button" class="go" data-nudge-go></button>
    <button type="button" class="stay" data-nudge-close>Stay here</button>
  </div>
</div>

<style>
  .adventure {
    position: fixed;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    z-index: 70;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.45rem 0.45rem 0.45rem 1rem;
    background: var(--color-surface);
    font-family: var(--font-ui);
    transition: translate 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }
  /* Scrolling down tucks the switch below the screen. Scrolling up or reaching the end brings it back. */
  :global([data-chrome="tucked"]) .adventure {
    translate: 0 calc(100% + 2rem);
  }
  .cyoa {
    font-size: 0.8rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .options {
    position: relative;
    display: flex;
    background: var(--color-bg);
  }
  .pill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    background: var(--color-accent);
  }
  .options button {
    position: relative;
    font: inherit;
    font-size: 0.8rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 0;
    background: transparent;
    color: var(--color-text-soft);
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.12s steps(2);
  }
  .options button[aria-pressed="true"] {
    color: var(--color-bg);
  }
  .options button:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }
  @media (max-width: 560px) {
    .cyoa {
      display: none;
    }
    .adventure {
      padding-left: 0.45rem;
    }
  }

  .nudge {
    position: fixed;
    left: 50%;
    bottom: calc(5.2rem + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    z-index: 71;
    width: min(26rem, calc(100vw - 2rem));
    padding: 1rem 1.1rem;
    background: var(--color-text);
    color: var(--color-bg);
  }
  .nudge-text {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .nudge-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .nudge button {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 0;
    cursor: pointer;
  }
  .go {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .stay {
    background: transparent;
    color: var(--color-bg);
    box-shadow: inset 0 0 0 2px var(--color-bg);
  }
</style>

<script>
  import { animate, scrambleText, spring } from "animejs";
  import { pixelWipe } from "../scripts/wipe";

  type Mode = "serious" | "afterhours";
  const root = document.documentElement;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const pill = document.querySelector<HTMLElement>(".adventure .pill")!;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-site]"));
  const nudge = document.querySelector<HTMLElement>(".nudge")!;
  const current = () => root.dataset.siteMode as Mode;

  // The accent pill springs across to whichever version is active.
  function paint(instant = false) {
    const active = buttons.find((b) => b.dataset.site === current())!;
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === active)));
    const to = { x: active.offsetLeft, width: active.offsetWidth };
    if (instant || reduce) {
      pill.style.transform = `translateX(${to.x}px)`;
      pill.style.width = `${to.width}px`;
      return;
    }
    animate(pill, { x: to.x, width: to.width, ease: spring({ stiffness: 220, damping: 18 }) });
  }

  function choose(mode: Mode) {
    hideNudge();
    try {
      localStorage.setItem("siteMode", mode);
    } catch {
      /* storage blocked */
    }
    if (mode === current()) return;
    pixelWipe(() => {
      root.dataset.siteMode = mode;
      dispatchEvent(new CustomEvent("site:mode", { detail: { mode } }));
      paint();
    }, "bottom-center");
  }

  buttons.forEach((b) => b.addEventListener("click", () => choose(b.dataset.site as Mode)));

  // First visit: explain which version the clock picked, and offer the other.
  function showNudge() {
    const now = new Date();
    const when = now.toLocaleString(undefined, { weekday: "long", hour: "numeric", minute: "2-digit" });
    const serious = current() === "serious";
    const text = nudge.querySelector<HTMLElement>(".nudge-text")!;
    const go = nudge.querySelector<HTMLButtonElement>("[data-nudge-go]")!;
    text.textContent = (serious ? nudge.dataset.serious : nudge.dataset.afterhours)!.replace("{when}", when);
    go.textContent = serious ? nudge.dataset.play! : "Go Serious";
    go.onclick = () => choose(serious ? "afterhours" : "serious");
    nudge.hidden = false;
    if (!reduce) {
      animate(nudge, { opacity: [0, 1], y: [24, 0], translateX: "-50%", ease: spring({ stiffness: 200, damping: 16 }) });
      animate(go, { innerHTML: scrambleText({ chars: "blocks", text: go.textContent ?? "" }) });
    }
    try {
      localStorage.setItem("nudged", "1");
    } catch {
      /* storage blocked */
    }
  }

  function hideNudge() {
    if (nudge.hidden) return;
    if (reduce) {
      nudge.hidden = true;
      return;
    }
    animate(nudge, { opacity: 0, y: 16, translateX: "-50%", duration: 180, ease: "inQuad", onComplete: () => (nudge.hidden = true) });
  }
  nudge.querySelector("[data-nudge-close]")?.addEventListener("click", hideNudge);

  paint(true);
  // Fonts, a mode swap or a resize can change the button widths, so the pill re-measures whenever the row resizes.
  new ResizeObserver(() => paint(true)).observe(document.querySelector(".adventure .options")!);
  document.fonts?.ready.then(() => paint(true));

  let lastY = scrollY;
  addEventListener(
    "scroll",
    () => {
      const y = scrollY;
      const atEnd = innerHeight + y >= document.documentElement.scrollHeight - 80;
      const tuck = y > lastY + 4 && y > 200 && !atEnd && nudge.hidden;
      if (tuck) root.dataset.chrome = "tucked";
      else if (y < lastY - 4 || atEnd) delete root.dataset.chrome;
      lastY = y;
    },
    { passive: true },
  );
  let seen = false;
  try {
    seen = localStorage.getItem("nudged") === "1";
  } catch {
    /* storage blocked */
  }
  if (root.dataset.modeChosen !== "1" && !seen) setTimeout(showNudge, 1400);
</script>
