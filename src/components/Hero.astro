---
import { bio } from "../data/bio";
import { icons } from "./icons";
import { hypeStops, hypeDefault, hypeLabels } from "../data/hype";
import WovenBackground from "./WovenBackground.astro";
const { hero, social } = bio;
const iconKey: Record<string, string> = {
  linkedin: "linkedin",
  github: "github",
  envelope: "envelope",
  x: "x",
};
const hypeValue = Math.round((hypeDefault / (hypeStops.length - 1)) * 100);
---

{/* Synchronously mark the doc as animating BEFORE the name paints, so the
    pre-reveal hidden state applies without a flash of fully-visible text.
    Skipped under reduced-motion (name stays visible). */}
<script is:inline>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("js-anim");
  }
</script>

<header class="home">
  <WovenBackground />
  <div class="overlay">
    <p class="greeting serious-only">I'm</p>
    <h1 class="name" aria-label={`${hero.nameFirst} ${hero.nameLast}`}>
      <span class="name-inner" aria-hidden="true">
        <span class="word">{hero.nameFirst}</span>{" "}<span class="word">{hero.nameLast}</span>
      </span>
    </h1>
    <div class="hype" data-stop={hypeDefault}>
      {/* Serious mode always reads the human bio. After hours lets the slider rewrite it. */}
      <div class="bio serious-only" set:html={hypeStops[hypeDefault].html}></div>
      <div class="hype-copy afterhours-only" set:html={hypeStops[hypeDefault].html}></div>
      {/* The buttons sit above the slider, so After hours shows them on a laptop's first screen too. */}
      <div class="buttons">
        {hero.cta.map((c) => (
          <a class="top-button px-frame" href={c.href}>{c.label}</a>
        ))}
      </div>
      <button type="button" class="hype-stamp afterhours-only" tabindex="-1" aria-hidden="true">
        <span class="stamp-main">♻ Repost if you agree</span>
        <span class="stamp-count"><span data-reposts>12,847</span> reposts</span>
      </button>
      <div class="hype-control afterhours-only">
        <span class="hype-bubble" aria-hidden="true">{hypeStops[hypeDefault].label}</span>
        <input
          type="range"
          min="0"
          max="100"
          step="1"
          value={hypeValue}
          aria-label="Tone of the bio, from touch grass to thought leader"
          aria-valuetext={hypeStops[hypeDefault].label}
          data-stops={JSON.stringify(hypeStops)}
        />
        <div class="hype-labels" aria-hidden="true"><span>{hypeLabels.less}</span><span>{hypeLabels.more}</span></div>
      </div>
    </div>
    {/* The copy box reserves the tallest stop's height, so moving the slider never shifts the page below it.
        This runs while the page is still parsing, so the box has its final height on the first paint and the
        centered hero doesn't jump once the slider script loads. The probe flips data-stop for each measurement
        and restores it in the same task, so nothing paints mid-measure. */}
    <script is:inline>
      window.reserveHype = function () {
        var hype = document.querySelector(".hype");
        var copy = hype && hype.querySelector(".hype-copy");
        var input = hype && hype.querySelector("input");
        if (!copy || !input || !copy.clientWidth) return;
        var probe = copy.cloneNode(false);
        probe.style.cssText = "position:absolute;visibility:hidden;min-height:0;width:" + copy.clientWidth + "px";
        hype.appendChild(probe);
        var was = hype.dataset.stop;
        var tallest = 0;
        JSON.parse(input.dataset.stops || "[]").forEach(function (stop, i) {
          hype.dataset.stop = String(i);
          probe.innerHTML = stop.html;
          tallest = Math.max(tallest, probe.offsetHeight);
        });
        hype.dataset.stop = was;
        probe.remove();
        copy.style.minHeight = tallest + "px";
      };
      window.reserveHype();
    </script>
    <div class="list-inline">
      {social.map((s) => (
        <div>
          <a class="icon" href={s.href} title={s.label} aria-label={s.label} rel="me noopener" target={s.href.startsWith("http") ? "_blank" : undefined}>
            <span class="social-svg" set:html={icons[iconKey[s.icon]]}></span>
          </a>
        </div>
      ))}
    </div>
  </div>
</header>

<style>
  :global(.reaction) {
    position: fixed;
    z-index: 90;
    font-size: 1.6rem;
    pointer-events: none;
  }
  .home {
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Extra bottom room keeps the scroll hint clear of the pinned adventure switch. */
    padding: 5rem 1.5rem 9rem;
    background: transparent;
    position: relative;
    overflow: hidden;
  }
  .overlay {
    position: relative;
    z-index: 1;
    max-width: 720px;
    text-align: center;
  }
  /* Scrim: a soft pool of the page background behind the text so the particle
     field reads as ambience, not noise. Sits above the canvas, below the text. */
  .overlay::before {
    content: "";
    position: absolute;
    inset: -12% -22%;
    z-index: -1;
    background: radial-gradient(
      ellipse at center,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 72%, transparent) 42%,
      transparent 72%
    );
    pointer-events: none;
  }
  /* Serious mode on wide screens sets the text on the left, so the portrait field has the right half. */
  @media (min-width: 1100px) {
    :global(:root:not([data-site-mode="afterhours"])) .home {
      justify-content: flex-start;
      padding-left: max(1.5rem, 7vw);
    }
    :global(:root:not([data-site-mode="afterhours"])) .overlay {
      max-width: min(620px, 46vw);
      text-align: left;
    }
    :global(:root:not([data-site-mode="afterhours"])) .name {
      font-size: clamp(3.5rem, 7vw, 6.5rem);
    }
    :global(:root:not([data-site-mode="afterhours"])) .hype {
      margin-left: 0;
    }
    :global(:root:not([data-site-mode="afterhours"])) .buttons,
    :global(:root:not([data-site-mode="afterhours"])) .list-inline {
      justify-content: flex-start;
    }
  }
  /* Below that width the field sits above the name, so the hero stacks. */
  @media (max-width: 1099px) {
    :global(:root:not([data-site-mode="afterhours"])) .home {
      flex-direction: column;
      padding-top: 4.5rem;
    }
  }
  /* After hours shades text with the pixel world's own panels, and this pool would wash out the hero waiting under the slider. */
  :global([data-site-mode="afterhours"]) .overlay::before {
    display: none;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(3.5rem, 11vw, 7.5rem);
    line-height: 0.95;
    margin: 0 0 1.75rem;
    letter-spacing: -0.055em;
    /* A halo in the page color lifts the name off the pixel world behind it. */
    text-shadow: 0 2px 28px var(--color-bg);
  }
  .name-inner {
    display: inline;
  }
  .word {
    display: inline-block;
  }
  /* While a word decodes, its box is pinned to the settled width and the wider block glyphs center inside it. */
  .word:global(.decoding) {
    display: inline-flex;
    justify-content: center;
    white-space: nowrap;
  }
  /* .js-anim is set on <html> before paint, so the name stays hidden until the
     decode starts. It's absent under reduced motion or without JS. */
  :global(.js-anim) .word {
    visibility: hidden;
  }
  .greeting {
    font-family: var(--font-ui);
    font-size: 1rem;
    color: var(--color-teal);
    margin: 0 0 0.75rem;
  }
  .hype-control {
    position: relative;
  }
  /* A pixel speech bubble rides the slider thumb and names the current stop. */
  .hype-bubble {
    position: absolute;
    bottom: calc(100% - 4px);
    left: calc((100% - 18px) * var(--v, 0.25) + 9px);
    transform: translateX(-50%);
    padding: 0.4rem 0.6rem;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
  }
  .hype-bubble::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    width: 8px;
    height: 4px;
    margin-left: -4px;
    background: var(--color-accent);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }
  .hype {
    position: relative;
    max-width: 38rem;
    margin: 0 auto;
  }
  /* After hours leaves a gap under the slider, where the hero waits until the reader scrolls. */
  :global([data-site-mode="afterhours"]) .hype {
    margin-bottom: 5rem;
  }
  .bio,
  .hype-copy {
    font-size: 1.2rem;
    line-height: 1.6;
    text-wrap: pretty;
    min-height: 7.7em;
    margin: 0 0 2.5rem;
    color: var(--color-text);
  }
  .bio :global(p),
  .hype-copy :global(p) {
    margin: 0 0 0.85em;
  }
  .hype-copy :global(.w) {
    display: inline-block;
    will-change: transform, opacity;
  }
  /* The top stop drops the editorial voice for a pixel-type infomercial. */
  .hype[data-stop="4"] .hype-copy {
    font-family: "Silkscreen", var(--font-ui);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-accent-strong);
  }
  /* The top stop's call to action: a rubber stamp that reposts itself when pressed. */
  .hype-stamp {
    position: absolute;
    left: 50%;
    top: 40%;
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    padding: 0.7rem 1.1rem;
    border: 4px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    font-family: "Silkscreen", var(--font-ui);
    color: var(--color-accent);
    white-space: nowrap;
    cursor: pointer;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-7deg) scale(0.4);
  }
  .stamp-main {
    font-size: clamp(1.2rem, 3.4vw, 2.3rem);
    line-height: 1;
  }
  .stamp-count {
    font-size: 0.8rem;
    color: var(--color-text);
  }
  .hype-stamp:focus-visible {
    outline: 3px solid var(--color-teal);
    outline-offset: 4px;
  }
  .hype[data-stop="4"] .hype-stamp {
    pointer-events: auto;
  }
  .hype-control {
    display: grid;
    gap: 0.6rem;
  }
  .hype-control input {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 44px;
    background: transparent;
    cursor: pointer;
    margin: 0;
  }
  .hype-control input::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(90deg, var(--color-text) var(--fill, 25%), var(--color-line) var(--fill, 25%));
  }
  .hype-control input::-moz-range-track {
    height: 2px;
    background: var(--color-line);
  }
  .hype-control input::-moz-range-progress {
    height: 2px;
    background: var(--color-text);
  }
  .hype-control input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    margin-top: -8px;
    border-radius: 0;
    background: var(--color-text);
    box-shadow: 0 0 0 3px var(--color-bg);
    transition: transform 0.15s ease;
  }
  .hype-control input::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 0;
    border-radius: 0;
    background: var(--color-text);
  }
  .hype-control input:active::-webkit-slider-thumb {
    transform: scale(1.25) rotate(45deg);
  }
  .hype-control input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .hype-labels {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }
  /* After hours follows the buttons with the slider, whose label bubble needs room above the track. */
  :global([data-site-mode="afterhours"]) .buttons {
    margin-bottom: 3.25rem;
  }
  .top-button {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    line-height: 1;
    text-decoration: none;
    transition: background-color 0.12s steps(2), color 0.12s steps(2);
  }
  .top-button:hover,
  .top-button:focus-visible {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .list-inline {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }
  .icon {
    color: var(--color-text-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .icon:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .social-svg {
    display: inline-flex;
    width: 28px;
    height: 28px;
  }
  .social-svg :global(svg) {
    width: 100%;
    height: 100%;
  }
  /* On phones three centered paragraphs are hard to read, so the hero sets left-aligned, buttons and icons included.
     This block comes last so it beats the centered defaults above. The bio is also set a step smaller, which brings
     the name and the buttons about a third of a screen closer to the top. */
  @media (max-width: 640px) {
    .overlay {
      text-align: left;
    }
    .buttons,
    .list-inline {
      justify-content: flex-start;
    }
    .buttons {
      gap: 0.5rem;
    }
    .list-inline {
      margin-left: -8px; /* the icons' 44px tap targets pad them in, so this lines the first glyph up with the text */
    }
    .bio,
    .hype-copy {
      font-size: 1.05rem;
      line-height: 1.55;
    }
    /* Pixel type is wide, so After hours trims the buttons to keep all three on one row. */
    :global([data-site-mode="afterhours"]) .top-button {
      padding-inline: 0.9rem;
      font-size: 0.8rem;
    }
  }
  /* A short laptop screen gets less air above the name, which keeps the buttons on the first screen at 720px tall. */
  @media (min-width: 1100px) and (max-height: 800px) {
    .home {
      padding-top: 2.5rem;
    }
  }
  /* Below 1100px Serious mode stacks the portrait above the text, which pushes everything down. There the buttons
     go straight under the name, so a visitor with half a minute reaches the resume and the email without scrolling
     past the bio. */
  @media (max-width: 1099px) {
    :global(:root:not([data-site-mode="afterhours"])) .hype {
      display: flex;
      flex-direction: column;
    }
    :global(:root:not([data-site-mode="afterhours"])) .buttons {
      order: -1;
      margin-bottom: 1.75rem;
    }
    :global(:root:not([data-site-mode="afterhours"])) .bio {
      margin-bottom: 1.5rem;
    }
    :global(:root:not([data-site-mode="afterhours"])) .name {
      margin-bottom: 1.25rem;
    }
  }
</style>

<script>
  import { animate, stagger, spring, splitText, scrambleText } from "animejs";
  import { stopForValue } from "../scripts/companion/world";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const springy = spring({ stiffness: 140, damping: 14 });

  if (!reduce) {
    // The name decodes out of pixel block glyphs from its center while each word settles on a spring.
    const words = document.querySelectorAll<HTMLElement>(".name .word");
    words.forEach((w) => (w.style.visibility = "visible"));
    // Serious mode skips the block-glyph decode and keeps only the spring.
    if (document.documentElement.dataset.siteMode === "afterhours") {
      // Block glyphs are wider than letters, so the name keeps its settled height while
      // it decodes. Otherwise it wraps to an extra line and shoves the page down.
      const name = document.querySelector<HTMLElement>(".name");
      if (name) name.style.height = `${name.offsetHeight}px`;
      // Each word also keeps its settled width, and its glyphs spill evenly past both edges.
      // Otherwise the second word drops to a new line on top of the bio until the decode ends.
      words.forEach((w) => {
        w.style.width = `${w.offsetWidth}px`;
        w.classList.add("decoding");
      });
      const settle = () => {
        if (name) name.style.height = "";
        words.forEach((w) => {
          w.style.width = "";
          w.classList.remove("decoding");
        });
      };
      animate(words, {
        innerHTML: scrambleText({ chars: "blocks", from: "center", perturbation: 0.4, revealRate: 9, settleDuration: 700 }),
        delay: stagger(160, { start: 350 }),
        onComplete: settle,
      });
    }
    animate(words, { y: [26, 0], opacity: [0, 1], delay: stagger(160, { start: 350 }), ease: springy });
  }

  type Stop = { label: string; html: string };
  const hype = document.querySelector<HTMLElement>(".hype");
  const input = hype?.querySelector<HTMLInputElement>("input");
  const copy = hype?.querySelector<HTMLElement>(".hype-copy");
  const stamp = hype?.querySelector<HTMLElement>(".hype-stamp");

  if (hype && input && copy && stamp) {
    const stops: Stop[] = JSON.parse(input.dataset.stops || "[]");
    let current = Number(hype.dataset.stop);
    let token = 0;

    // Reuse the spans from the last split so the paragraph never nests wrappers.
    const words = () => {
      const existing = copy!.querySelectorAll<HTMLElement>(".w");
      return existing.length ? [...existing] : (splitText(copy!, { words: { class: "w" } }).words as HTMLElement[]);
    };

    // A fast drag cancels a copy swap halfway, so the stamp tracks whether it's showing instead of trusting the last stop.
    let stampShown = current === 4;
    async function show(next: number) {
      const mine = ++token;
      current = next;
      input!.setAttribute("aria-valuetext", stops[next].label);
      if (bubble) {
        bubble.textContent = stops[next].label;
        if (!reduce) animate(bubble, { scale: [1.35, 1], ease: spring({ stiffness: 260, damping: 12 }) });
      }
      dispatchEvent(new CustomEvent("hype:change", { detail: { stop: next } }));

      // The stamp is only reachable while it's on screen.
      stamp!.tabIndex = next === 4 ? 0 : -1;
      stamp!.setAttribute("aria-hidden", String(next !== 4));

      if (reduce) {
        copy!.innerHTML = stops[next].html;
        hype!.dataset.stop = String(next);
        stamp!.style.opacity = next === 4 ? "1" : "0";
        stamp!.style.transform = "translate(-50%, -50%) rotate(-7deg) scale(1)";
        return;
      }

      if (next !== 4 && stampShown) {
        stampShown = false;
        animate(stamp!, { opacity: 0, scale: 0.4, duration: 200, ease: "inQuad" });
      }

      // Words leave upward, the copy swaps, then new words spring in.
      await animate(words(), { opacity: 0, y: -10, duration: 160, delay: stagger(6), ease: "inQuad" });
      if (mine !== token) return;
      copy!.innerHTML = stops[next].html;
      hype!.dataset.stop = String(next);
      animate(words(), { opacity: [0, 1], y: [14, 0], delay: stagger(next === 4 ? 22 : 9), ease: springy });

      if (next === 4) {
        stampShown = true;
        animate(stamp!, {
          opacity: [0, 1],
          scale: [3.2, 1],
          rotate: [-18, -7],
          translateX: ["-50%", "-50%"],
          translateY: ["-50%", "-50%"],
          ease: spring({ stiffness: 220, damping: 11 }),
        });
        animate(hype!, { x: [0, -6, 6, -4, 4, 0], duration: 360, delay: 120, ease: "linear" });
      }
    }

    // The inline script beside the markup reserved the copy box's height before the first paint.
    // Fonts, a resize or a mode swap can change how the copy wraps, so it measures again after each.
    const reserve = () => (window as unknown as { reserveHype?: () => void }).reserveHype?.();
    document.fonts?.ready.then(reserve);
    addEventListener("resize", reserve);
    addEventListener("site:mode", reserve);

    const bubble = hype.querySelector<HTMLElement>(".hype-bubble");
    const fill = () => {
      input.style.setProperty("--fill", `${input.value}%`);
      bubble?.parentElement?.style.setProperty("--v", String(Number(input.value) / 100));
    };
    input.addEventListener("input", () => {
      fill();
      const next = stopForValue(Number(input.value), stops.length);
      if (next !== current) show(next);
    });
    // On release the thumb glides to the nearest notch.
    input.addEventListener("change", () => {
      const target = { v: Number(input.value) };
      const to = (stopForValue(target.v, stops.length) / (stops.length - 1)) * 100;
      animate(target, { v: to, duration: reduce ? 0 : 260, ease: "outQuart", onUpdate: () => { input.value = String(Math.round(target.v)); fill(); } });
    });
    fill();

    // Reposting sprays LinkedIn reactions out of the stamp and bumps the count.
    let reposts = 12847;
    const counter = stamp.querySelector<HTMLElement>("[data-reposts]");
    stamp.addEventListener("click", () => {
      reposts += 1 + Math.floor(Math.random() * 40);
      if (counter) counter.textContent = reposts.toLocaleString();
      dispatchEvent(new CustomEvent("hype:repost"));
      if (reduce) return;
      animate(stamp, { scale: [0.86, 1], ease: spring({ stiffness: 400, damping: 10 }) });
      const r = stamp.getBoundingClientRect();
      const reactions = ["👏", "💡", "❤️", "🎉", "🚀", "🙌", "💯"];
      const bits = Array.from({ length: 22 }, (_, i) => {
        const b = document.createElement("span");
        b.className = "reaction";
        b.textContent = reactions[i % reactions.length];
        b.style.left = `${r.left + r.width / 2}px`;
        b.style.top = `${r.top + r.height / 2}px`;
        document.body.appendChild(b);
        return b;
      });
      animate(bits, {
        x: () => (Math.random() - 0.5) * 520,
        y: () => -120 - Math.random() * 360,
        rotate: () => (Math.random() - 0.5) * 120,
        scale: [0.4, 1.4],
        opacity: [1, 1, 0],
        duration: () => 900 + Math.random() * 600,
        ease: "outCubic",
        delay: stagger(18),
        onComplete: () => bits.forEach((b) => b.remove()),
      });
    });
  }
</script>
