---
import { awards } from "../data/awards";
import SectionHeader from "./SectionHeader.astro";
---

<section class="awardsandinvolvements section-anchor" id="awards">
  <div class="container">
    <SectionHeader section="awards" />
    <div class="grid">
      {awards.map((a) => (
        <article class="card">
          <a class="logo-mark" data-mat={a.mat} href={a.link} target="_blank" rel="noopener">
            <img src={a.logo} alt={a.title} width="92" height="92" loading="lazy" decoding="async" />
          </a>
          <h3>{a.title}</h3>
          <p class="when">{a.when}</p>
          <p>{a.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .awardsandinvolvements {
    padding: 5rem 1.5rem;
    background: transparent;
  }
  .container {
    max-width: 1000px;
    margin: 0 auto;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2.5rem 2rem;
  }
  /* Cards read left to right like the Projects and Talks cards, so a short last row doesn't look stranded. */
  .card {
    text-align: left;
  }
  .logo-mark {
    margin: 0 0 1rem;
  }
  h3 {
    font-size: var(--text-card-title);
    font-weight: 500;
    margin: 0 0 0.2rem;
  }
  p.when {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
  }
  p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-soft);
    margin: 0;
  }
</style>
