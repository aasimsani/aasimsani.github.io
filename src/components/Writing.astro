---
// The homepage's Writing section: the newest posts from src/data/posts.ts, and
// the way to the rest. It needs no upkeep, because a new post shows up here as
// soon as it has an entry there.
import { newestFirst } from "../data/posts";
import SectionHeader from "./SectionHeader.astro";
import PostCard from "./PostCard.astro";

const all = newestFirst();
const shown = all.slice(0, 3);
---

<section class="writing section-anchor" id="writing">
  <div class="container">
    <SectionHeader section="writing" />
    <div class="posts">
      {shown.map((post) => <PostCard post={post} level="h3" />)}
    </div>
    <p class="more">
      {all.length > shown.length && (
        <>
          <a href="/blog/">All {all.length} essays</a>
          <span aria-hidden="true">&middot;</span>
        </>
      )}
      <a href="/rss.xml">Follow by RSS</a>
    </p>
  </div>
</section>

<style>
  .writing {
    padding: 5rem 1.5rem;
    background: transparent;
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
  }
  .posts {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .more {
    display: flex;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.82rem;
  }
</style>
