---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /* Per-page social-card overrides — defaults preserve the homepage's profile card. */
  ogType?: string;
  ogTitle?: string;
  ogImage?: string;
  canonical?: string;
  publishedTime?: string;
}

const {
  title = site.title,
  description = site.description,
  ogType = "profile",
  ogTitle = site.ogTitle,
  ogImage = site.ogImage,
  canonical = site.url,
  publishedTime,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* Inline theme init — runs synchronously before paint to prevent FOUC. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) { /* localStorage blocked */ }
      })();
    </script>
    {/* Pick Serious or After hours before paint. A ?mode= link wins, then the
        visitor's saved choice, then their local clock: weekdays 9 to 6 get
        Serious, everything else gets After hours. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var mode = "serious";
        var chosen = "0";
        try {
          var param = new URLSearchParams(location.search).get("mode");
          var saved = localStorage.getItem("siteMode");
          if (param === "serious" || param === "afterhours") {
            mode = param;
            chosen = "1";
          } else if (saved === "serious" || saved === "afterhours") {
            mode = saved;
            chosen = "1";
          } else {
            var d = new Date();
            var workday = d.getDay() >= 1 && d.getDay() <= 5 && d.getHours() >= 9 && d.getHours() < 18;
            mode = workday ? "serious" : "afterhours";
          }
        } catch (e) { /* storage blocked: stay serious */ }
        root.dataset.siteMode = mode;
        root.dataset.modeChosen = chosen;
      })();
    </script>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.ogSiteName} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {publishedTime && <meta property="article:author" content={`${site.firstName} ${site.lastName}`} />}

    <meta name="twitter:creator" content={site.twitterCreator} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <meta name="description" content={description} />

    <meta property="profile:first_name" content={site.firstName} />
    <meta property="profile:last_name" content={site.lastName} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Silkscreen:wght@400;700&display=swap"
    />
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
